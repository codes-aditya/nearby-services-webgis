      <virtualTable>
        <name>nearby_pois</name>
        <sql>SELECT id, name, category, subcategory, address, phone, website, opening_hours,&#xd;
  ST_Y(geom) AS y_lat,&#xd;
  ST_X(geom) AS x_lng,&#xd;
  ST_Distance(geom::geography,&#xd;
    ST_SetSRID(ST_MakePoint(%lng%,%lat%),4326)::geography) AS dist_m,&#xd;
  geom&#xd;
FROM poi&#xd;
WHERE category = ANY(string_to_array(&apos;%cats%&apos;,&apos;|&apos;))&#xd;
  AND (&apos;%sub%&apos; = &apos;all&apos; OR subcategory = &apos;%sub%&apos;)&#xd;
  AND ST_DWithin(geom::geography,&#xd;
    ST_SetSRID(ST_MakePoint(%lng%,%lat%),4326)::geography, %radius%)&#xd;
ORDER BY dist_m&#xd;
LIMIT %n%
</sql>
